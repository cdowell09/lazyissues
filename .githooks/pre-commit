#!/bin/sh
# Keeps formatting, lint and types clean. Enable once per clone with:
#   git config core.hooksPath .githooks
# Skip for a single commit with: git commit --no-verify
set -eu

# Docs-only and other non-Python commits don't need checks.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -Eq '\.py$|^pyproject\.toml$|^uv\.lock$'; then
    exit 0
fi

echo "pre-commit: ruff format --check"
uv run ruff format --check

echo "pre-commit: ruff check"
uv run ruff check

echo "pre-commit: ty check"
uv run ty check
